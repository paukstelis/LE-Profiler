{# profiler_tab.jinja2 #}

<style>
    /* ── Laser committed-layer list ─────────────────────────── */
    .layer-list       { margin-top: 6px; }
    .layer-item       {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 8px;
        border-radius: 4px;
        margin-bottom: 4px;
        font-size: 13px;
        background: #f9f9f9;
        border: 1px solid #ddd;
    }
    .layer-swatch     { width: 14px; height: 14px; border-radius: 3px; flex-shrink: 0; }
    .layer-label      { flex: 1; }
    .layer-remove     {
        cursor: pointer;
        color: #999;
        font-size: 15px;
        line-height: 1;
        background: none;
        border: none;
        padding: 0 2px;
    }
    .layer-remove:hover { color: #c00; }
</style>

<div id="profiler_plugin_main" class="fluid-container">

    <div id="profiler_inputs">

        <!-- ── Drop downs ───────────────────────────────────── -->
        <div id="drops" class="span12">
            <div class="span6" style="width:300px; float:left;">
                <label for="modeSelect">Profiler Mode:</label>
                <select id="modeSelect" data-bind="value: mode">
                    <option value="none"></option>
                    <option title="Create horizontal basket illusion-style lines" value="laser">Laser</option>
                    <option title="Cut a variety of flute styles" value="flute">Flute</option>
                    <option title="Wrap an existing 3-axis Gcode onto the surface" value="wrap">Wrap</option>
                    <option title="Create facets or scallops on an object" value="facet">Facet</option>
                </select>
            </div>

            <div class="span6">
                <div>
                    <label for="scan_file_select">Select Scan File:</label>
                    <select id="scan_file_select">
                    <option value="">Loading...</option>
                    </select>
                </div>
                <div>
                    <button id="reverseZButton">Reverse Profile</button>
                </div>
            </div>
        </div>

        <div style="clear: both;"></div>
        <div id="markerActionContainer" class="span12" style="margin-bottom: 10px;">
            <label style="font-size: 12px; font-weight: bold;">Marker Selection:</label>
            <div style="display: flex; flex-wrap: nowrap; font-size: 12px;">
                <label style="font-size: 12px;margin-right: 15px;"><input type="radio" name="markerAction" value="zeroPoint" data-bind="checked: markerAction"> Set Zero</label>
                <label class="mode-section wrap facet flute" style="font-size: 12px;margin-right: 15px;"><input type="radio" class="mode-section wrap facet flute" name="markerAction" value="refset" data-bind="checked: markerAction"> Diameter Reference</label>
                <label style="font-size: 12px;margin-right: 15px;"><input type="radio" name="markerAction" value="Min" data-bind="checked: markerAction"> Set Min</label>
                <label style="font-size: 12px;margin-right: 15px;"><input type="radio" name="markerAction" value="Max" data-bind="checked: markerAction"> Set Max</label>
                <label style="font-size: 12px;margin-right: 15px;"><input type="radio" name="markerAction" value="targetPoint" data-bind="checked: markerAction"> Set Target</label>
            </div>
        </div>
        <div style="clear: both;"></div>
        <!-- ── Profile plot ──────────────────────────────────────── -->
        <div id="profilePlot" style="width: 100%; height: 500px;"></div>


        <div style="clear: both;"></div>
        <div id="machinecontrols" class="span12" style="margin-bottom: 10px;">
            <label style="font-size: 12px; font-weight: bold;">Machine Control:</label>
            <div style="display: flex; flex-wrap: nowrap; font-size: 12px;">
                <button style="margin-right: 10px;" class="btn btn-small" data-bind="click: function() { gotoposition('zero'); }">Move to Zero</button>
                <button style="margin-right: 10px;" class="btn btn-small" data-bind="click: function() { gotoposition('target'); }">Move to Target</button>
                <button style="margin-right: 10px;" class="btn btn-small" data-bind="click: function() { gotoposition('min'); }">Move to Min</button>
                <button style="margin-right: 10px;" class="btn btn-small" data-bind="click: function() { gotoposition('max'); }">Move to Max</button>
                <button style="margin-right: 10px;" class="btn btn-small laser" data-bind="visible: laser_mode(), enable: laser_mode(), click: function() {}">Weak Laser</button>
            </div>
        </div>
        <!-- ── Custom Line Layout (laser only) ──────────────────── -->
        <div class="control-group laser" style="display:none;">
            <label class="control-label">Custom Line Layout</label>
            <div class="controls" style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
                <button id="openPolarEditor" class="btn"
                        data-bind="click: openPolarEditor">Edit Lines</button>
                <button class="btn btn-success"
                        data-bind="click: commitLayer">Commit Layer</button>
            </div>
        </div>

        <!-- ══════════════════════════════════════════════════════════
             LASER — Committed Layers Panel
             Sits below both columns, visible only in laser mode.
        ═══════════════════════════════════════════════════════════ -->
        <div class="mode-section laser" style="display:none; clear:both; margin-top:12px;">

            <hr style="margin: 6px 0;">
            <strong>Committed Layers</strong>

            <!-- Empty state -->
            <!-- ko if: laser_sections().length === 0 -->
            <p style="color:#999; font-size:12px; margin-top:4px;">
                No layers yet. Set Min / Max on the profile, configure lines, then click
                <em>Commit Layer</em>.
            </p>
            <!-- /ko -->

            <!-- Layer list -->
            <div class="layer-list">
                <!-- ko foreach: laser_sections -->
                <div class="layer-item">
                    <div class="layer-swatch"
                         data-bind="style: { background: color }"></div>
                    <span class="layer-label"
                          data-bind="text: 'Layer ' + id + ':  '
                                         + vMin.toFixed(2) + ' → ' + vMax.toFixed(2)
                                         + '  (' + angles.length + ' lines),'
                                         + 'Feed: ' + feed.toString() + ', Power: '+ power.toString()">
                    </span>
                    <button class="layer-remove"
                            title="Remove this layer"
                            data-bind="click: $parent.removeLayer">✕</button>
                </div>
                <!-- /ko -->
            </div>

            <!-- Clear all -->
            <!-- ko if: laser_sections().length > 0 -->
            <button class="btn btn-small btn-danger"
                    style="margin-top:6px;"
                    data-bind="click: clearAllLayers">Clear All Layers</button>
            <!-- /ko -->

        </div><!-- /laser layers panel -->

        <!-- ── Polar editor (laser only) ────────────────────────── -->
        <div id="polarEditorModal" class="laser" style="display:none; width:100%;">
            <div id="polarPlot"></div>
            <div class="controls" style="margin-top:4px;">
                <label><input type="radio" name="polarMode" value="add" checked> Add Line</label>
                &nbsp;
                <label><input type="radio" name="polarMode" value="delete"> Delete Line</label>
                &nbsp;
                <label>Symmetry:
                    <select id="polarSymmetry" data-bind="value: polarSymmetry">
                        <option value="1">None</option>
                        <option value="2">180°</option>
                        <option value="4">90°</option>
                    </select>
                </label>
            </div>
        </div>

        <!-- ── Two-column controls ───────────────────────────────── -->
        <div id="pcontrols" class="span12">

            <!-- ── Left column ───────────────────────────────────── -->
            <div class="span6" style="width:300px; float:left;">



                <div class="mode-section wrap" id="wrapFileSelectContainer" style="display:none;">
                    <label for="wrapFileSelect">Wrap Gcode:</label>
                    <select id="wrapFileSelect">
                        <option value="">Loading...</option>
                    </select>
                </div>

                <div class="mode-section facet wrap flute" style="display:none;">
                    <label title="Establishes the diameter at a selectable point."
                           data-toggle="tooltip" for="refdiam">
                        Diameter at reference (mm):
                    </label>
                    <input id="refdiam" type="number" value="0" step="any"
                           data-bind="value: refdiam">
                </div>

                <div>
                    <label title="The distance from the end of the tool to the center of the B-axis."
                           data-toggle="tooltip" for="toollength">
                        Rotation center to surface (mm):
                    </label>
                    <input id="toollength" type="number" value="1" step="any"
                           data-bind="value: tool_length">
                </div>

                <div class="all">
                    <label title="Number of times the operation will be repeated using an angular offset of 360/segments."
                           data-toggle="tooltip" for="segment">
                        Segments:
                    </label>
                    <input id="segment" type="number" value="1" step="any"
                           data-bind="value: segments">
                </div>

                <div class="zscan" style="display:none;">
                    <label title="Z-scans operations can be done from either the front or back."
                           data-toggle="tooltip">
                        Tool direction:
                    </label>
                    <select id="tooldirection" data-bind="value: side">
                        <option value="none"></option>
                        <option value="front">Front (X+)</option>
                        <option value="back">Back (X-)</option>
                    </select>
                </div>

                <div class="mode-section laser flute facet" style="display:none;">
                    <label title="The linear feed rate" data-toggle="tooltip" for="feed">
                        Nominal Feedrate (mm/min):
                    </label>
                    <input id="feed" type="number" value="1000" step="any"
                           data-bind="value: feed">
                </div>

                <div id="laserPower" class="mode-section laser" style="display:none;">
                    <label title="The laser power used during cutting."
                           data-toggle="tooltip" for="power">
                        Laser Power:
                    </label>
                    <input id="power" type="number" value="1000" step="any"
                           data-bind="value: power">
                </div>

                <div class="mode-section flute facet" style="display:none;">
                    <label title="For fluting this is the total depth; for facets the maximum overall depth-of-cut."
                           data-toggle="tooltip" for="depth">
                        Total/Max Depth (mm):
                    </label>
                    <input id="depth" type="number" value="1" step="any"
                           data-bind="value: depth">
                </div>

                <div class="mode-section flute facet" style="display:none;">
                    <label title="For fluting this is the depth-of-cut per pass; for facets the maximum per pass."
                           data-toggle="tooltip" for="stepdown">
                        Step Down (mm):
                    </label>
                    <input id="stepdown" type="number" value="1" step="any"
                           data-bind="value: step_down">
                </div>

                <div class="mode-section facet" style="display:none;">
                    <label title="Scale factor for the depth of cut."
                           data-toggle="tooltip" for="depthmod">
                        Depth modifier:
                    </label>
                    <input id="depthmod" type="number" value="1.0" step="any"
                           data-bind="value: depth_mod">
                </div>

                <div class="mode-section laser" style="display:none;">
                    <label title="Do a test pass with weak laser power to verify positioning."
                           data-toggle="tooltip" for="test">
                        Test pass:
                        <input id="test" type="checkbox" data-bind="checked: test">
                    </label>
                </div>

                <div class="mode-section wrap" style="display:none;">
                    <label title="Project the gcode onto the work piece."
                           data-toggle="tooltip" for="ra">
                        Project:
                        <input id="ra" type="checkbox" data-bind="checked: radius_adjust">
                    </label>
                </div>

                <div class="mode-section facet" style="display:none;">
                    <label title="Inverts the cut depth to make lobes instead of facets."
                           data-toggle="tooltip" for="facetinvert">
                        Invert depths:
                        <input id="facetinvert" type="checkbox" data-bind="checked: facet_invert">
                    </label>
                </div>

            </div><!-- /span6 left -->

            <!-- ── Right column ──────────────────────────────────── -->
            <div class="span6">

                <div>
                    <label title="The maximum (positive) value for the B-axis."
                           data-toggle="tooltip" for="maxB">
                        Maximum B-angle:
                    </label>
                    <input id="maxB" type="number" value="1" step="any"
                           data-bind="value: max_B">
                </div>

                <div>
                    <label title="The minimum (negative) value for the B-axis."
                           data-toggle="tooltip" for="minB">
                        Minimum B-angle:
                    </label>
                    <input id="minB" type="number" value="1" step="any"
                           data-bind="value: min_B">
                </div>

                <div class="mode-section flute laser facet" style="display:none;">
                    <label title="The number of degrees to rotate the A-axis during each segment."
                           data-toggle="tooltip" for="Arot">
                        A-axis rotation:
                    </label>
                    <input id="Arot" type="number" value="1" step="any"
                           data-bind="value: Arot">
                </div>

                <div class="mode-section facet flute" id="svgFileSelectContainer" style="display:none;">
                    <label for="svgFileSelect">A rotation profile:</label>
                    <select id="svgFileSelect">
                        <option value="">Loading...</option>
                    </select>
                </div>

                <div class="mode-section facet flute" style="display:none;">
                    <label title="The diameter of the cutter used."
                           data-toggle="tooltip" for="tooldiam">
                        Tool Diameter (mm):
                    </label>
                    <input id="tooldiam" type="number" value="1" step="any"
                           data-bind="value: tool_diam">
                </div>

                <div class="mode-section facet" style="display:none;">
                    <label title="Fractional step over at the largest diameter based on tool diameter."
                           data-toggle="tooltip" for="stepover">
                        Step over (frac.):
                    </label>
                    <input id="stepover" type="number" value="0.5" max="1.0" step="any"
                           data-bind="value: step_over">
                </div>

                <div class="mode-section flute" style="display:none;">
                    <label title="Minimum acceptable distance between two flutes at the smallest diameter."
                           data-toggle="tooltip" for="flute_gap">
                        Minimum flute gap (mm):
                    </label>
                    <input id="flute_gap" type="number" value="1" step="any"
                           data-bind="value: flute_gap">
                </div>

                <div class="mode-section flute" style="display:none;">
                    <label title="The distance in mm to reach the final depth-of-cut."
                           data-toggle="tooltip" for="leadin">
                        Lead in (mm):
                    </label>
                    <input id="leadin" type="number" value="1" step="any"
                           data-bind="value: leadin">
                </div>

                <div class="mode-section flute" style="display:none;">
                    <label title="The distance in mm to retract before the end of the cut."
                           data-toggle="tooltip" for="leadout">
                        Lead out (mm):
                    </label>
                    <input id="leadout" type="number" value="1" step="any"
                           data-bind="value: leadout">
                </div>

                <!-- ── Super Advanced ─────────────────────────── -->
                <div class="advanced">
                    <details>
                        <summary>Super Advanced Features</summary>

                        <div>
                            <label for="increments">Step size (mm):</label>
                            <input id="increments" type="number" value="1" step="any"
                                   data-bind="value: increment">
                        </div>

                        <div class="mode-section wrap flute facet laser" style="display:none;">
                            <label for="smoothing">B-angle smoothing (points):</label>
                            <input id="smoothing" type="number" min="2" value="12" step="2"
                                   data-bind="value: smoothing">
                        </div>

                        <div class="mode-section flute" style="display:none;">
                            <label title="For fluting, every pass will start at smallest Z value."
                                   for="conventional">Single direction:</label>
                            <input id="conventional" type="checkbox"
                                   data-bind="checked: conventional">
                        </div>

                        <div class="mode-section wrap" style="display:none;">
                            <label for="singleB">Use single B-value for each operation:</label>
                            <input id="singleB" type="checkbox" data-bind="checked: singleB">
                        </div>

                        <div class="mode-section flute facet" style="display:none;">
                            <label title="Scales up feedrate during shallow passes."
                                   for="adaptive">Use adaptive feed rates:</label>
                            <input id="adaptive" type="checkbox" data-bind="checked: adaptive">
                        </div>

                        <div class="mode-section flute facet" style="display:none;">
                            <label for="fmod1">Adaptive feedrate max scale:</label>
                            <input id="fmod1" type="number" min="1" max="10" step="any"
                                   data-bind="value: feedscale">
                        </div>

                        <div class="mode-section facet" style="display:none;">
                            <label title="Feed for the first pass of inverted facets."
                                   for="fpass">First pass feedrate (mm/min):</label>
                            <input id="fpass" type="number" step="any"
                                   data-bind="value: fpass">
                        </div>

                        <div class="mode-section flute facet" style="display:none;">
                            <label title="Where Z will start. Negative = deeper initially."
                                   for="extra_depth">Z start depth:</label>
                            <input id="extra_depth" type="number" min="-5" max="10" step="any"
                                   data-bind="value: extra_depth">
                        </div>

                        <div class="mode-section flute facet wrap" style="display:none;">
                            <label title="Ignore ovality scan (if present)"
                                   for="ignore_oval">Ignore ovality data:</label>
                            <input id="ignore_oval" type="checkbox"
                                   data-bind="checked: ignore_oval">
                        </div>

                    </details>
                </div>

            </div><!-- /span6 right -->

        </div><!-- /#pcontrols -->

    </div><!-- /#profiler_inputs -->

    <br>

    <!-- ── Action buttons ───────────────────────────────────────── -->
    <div id="profiler_actions" style="clear:both; margin-top:20px;">
        <button id="write_gcode_button" class="btn btn-primary"
                data-bind="click: writeGCode">Write Job</button>
    </div>

</div>
